# Copy to .env and fill in. Vite only exposes variables that start with VITE_ to the browser,
# so never put secret keys here: these values end up in the public site.

# Hosted checkout page. When set, "Checkout" in the bag sends the shopper there with ?items=id:qty,id:qty
VITE_CHECKOUT_URL=https://checkout.example.com/tranzlife

# Endpoint that accepts the contact form as JSON (name, email, topic, msg), e.g. a form service or CRM webhook.
VITE_CONTACT_ENDPOINT=https://forms.example.com/tranzlife-contact

# ---- Tulsi wellness chat (built into npm run dev / preview / start) ----
# Read on the server side only, never sent to the browser (no VITE_ prefix).
# Local Ollama model. gemma2:9b gave the warmest, safest replies in testing; qwen2.5:7b is faster.
CHAT_MODEL=gemma2:9b
OLLAMA_URL=http://localhost:11434
# Port for npm start (the production server: site + chat)
PORT=3000
# Only if the chat API is hosted on a different domain from the site:
# CHAT_ORIGIN=https://www.tranzlife.example   (on the chat server: the site allowed to call it)
# VITE_CHAT_API=https://chat.tranzlife.example (at build time: where the site sends chat messages)
