# Copy to .env and fill in.
#
# ---------- public (browser) settings ----------
# Vite only exposes variables that start with VITE_ to the browser, and their values end up in the public site,
# so never put a secret in a VITE_ variable.

# Payment server base URL. Leave it empty and the checkout runs in TEST MODE: the whole flow is simulated in the
# browser and no money moves. Set it to take real payments:
#   /api                           when the site and the payment server share a domain (and in `npm run dev`)
#   https://pay.example.com/api    when the payment server runs on its own domain (then set PAYMENT_ALLOWED_ORIGIN)
VITE_PAYMENT_API=

# Endpoint that accepts the contact form as JSON (name, email, topic, msg), e.g. a form service or CRM webhook.
VITE_CONTACT_ENDPOINT=https://forms.example.com/tranzlife-contact

# ---------- payment server settings (server/, read by `npm run server`; never sent to the browser) ----------
# Razorpay: a QR code for each order on computers, Google Pay/PhonePe/Paytm/BHIM buttons on phones, and cards. The order
# confirms by itself (no UTR). Keys: Razorpay dashboard → Account & Settings → API Keys. Use rzp_test_… keys until your
# Razorpay KYC is approved, then switch to rzp_live_… keys. Without both, the site uses the fallback QR below and has no card tab.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Razorpay dashboard → Webhooks, URL https://<your site>/api/webhooks/razorpay, events payment.captured
# and order.paid). Without it, payments still confirm, but only while the customer's page or the admin page is open.
RAZORPAY_WEBHOOK_SECRET=

# Optional: your own UPI ID (the one printed on your company QR code; a business/merchant UPI ID is best). The site shows a
# QR code for it only when Razorpay is not available; customers then send the UTR, which you check on the admin page.
MERCHANT_UPI_ID=
# Payee name shown in the customer's UPI app.
MERCHANT_NAME=TranzLife Biosciences

# Password for the admin page (/api/admin) where you check UTRs and confirm payments. Use 12+ characters.
ADMIN_PASSWORD=

# Port for the payment server (the Vite dev proxy forwards /api here).
PAYMENT_PORT=8787

# Only when the site and the payment server are on different domains: the site's origin, e.g. https://tranzlife.in
PAYMENT_ALLOWED_ORIGIN=

# Set to true when the server runs behind a reverse proxy, so rate limiting sees the shopper's IP address.
PAYMENT_TRUST_PROXY=false

# Where orders are saved (default server/data/orders.json).
PAYMENT_DATA_FILE=
