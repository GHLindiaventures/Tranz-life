# Website settings. Copy to .env and fill in.
# The backend (login, accounts, orders, payments) has its own settings in backend/.env: see backend/.env.example.
#
# Vite only exposes variables that start with VITE_ to the browser, and their values end up in the public site,
# so never put a secret in a VITE_ variable.

# The backend's address. Leave it empty and login and checkout run in TEST MODE inside the browser: nothing is
# saved on a server and no money moves. Set it to use the real backend:
#   /api                           when the site and the backend share a domain (and in `npm run dev`, which forwards
#                                  /api to the backend on http://localhost:8787)
#   https://api.example.com/api    when the backend runs on its own domain (then set ALLOWED_ORIGIN in backend/.env)
VITE_PAYMENT_API=

# Endpoint that accepts the contact form as JSON (name, email, topic, msg), e.g. a form service or CRM webhook.
VITE_CONTACT_ENDPOINT=https://forms.example.com/tranzlife-contact

# Port of the backend that `npm run dev` forwards /api to (the backend's PORT, default 8787).
API_PORT=8787
