# Single API key:
GEMINI_API_KEY=your_key_here

# Or multiple API keys for automatic quota rotation (comma-separated):
# GEMINI_API_KEYS=key_1,key_2,key_3

MODEL=gemini-3.5-flash-lite
PORT=3000

# Comma-separated list of website origins allowed to call the bot (leave empty for same-origin only, or * for all)
ALLOWED_ORIGINS=
