{
  "name": "tranzlife-web",
  "version": "1.0.0",
  "private": true,
  "description": "TranzLife Biosciences marketing and shop website: 3D product scenes, pinned scroll story, molecule pipeline.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test:chat": "node --env-file-if-exists=.env scripts/tulsi-eval.mjs docs/tulsi-test-results.md",
    "test:understand": "node --env-file-if-exists=.env scripts/understand-eval.mjs",
    "insights": "node --env-file-if-exists=.env scripts/insights-report.mjs",
    "test:real": "node --env-file-if-exists=.env scripts/understand-eval.mjs --set real && node --env-file-if-exists=.env scripts/understand-eval.mjs --set real2",
    "optimize:glb": "node scripts/optimize-glb.mjs",
    "verify:glb": "node scripts/verify-models.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "gsap": "3.12.5",
    "lenis": "1.1.13",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "2.1.9"
  }
}
