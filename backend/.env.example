# Copy this file to backend/.env and fill it in. backend/.env is never committed (it holds secrets).
# Every setting is optional: with nothing set, the API runs on your computer with a local database, no payments and
# no login. backend/README.md explains each part.

# ---------- server ----------
PORT=8787
# Behind a proxy or host that sets X-Forwarded-For (Vercel, Render, nginx): true, so rate limits see the real visitor.
TRUST_PROXY=false
# Only when the website and the API are on different domains: the website's address, e.g. https://tranzlife.in
ALLOWED_ORIGIN=

# ---------- database (PostgreSQL) ----------
# Empty: a local Postgres runs inside Node (PGlite) and saves to backend/.data/db. Nothing to install.
# Live: the connection string of your hosted Postgres, e.g. from Neon:
#   postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/tranzlife?sslmode=require
DATABASE_URL=

# ---------- customer login (Twilio Verify texts the 6-digit code) ----------
# Twilio Console: Account SID and Auth Token on the home page; Verify -> Services -> your service -> Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Codes by email as well ("Use email instead" on the login screen): true once the Verify service has its email
# integration (SendGrid) set up in the Twilio Console. See backend/README.md, What you do manually.
TWILIO_VERIFY_EMAIL=false
# Without Twilio: true shows the code on the login screen instead of texting it. Anyone can then log in as any number,
# so use it only to try the site out, never on the live shop.
OTP_TEST_MODE=false

# ---------- payments ----------
# Razorpay dashboard -> Account & Settings -> API Keys (rzp_test_... until KYC is approved, then rzp_live_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard -> Webhooks: URL https://<your site>/api/webhooks/razorpay, events payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=
# Optional fallback QR code to your own UPI ID, used only when Razorpay is not available (customers then send the UTR)
MERCHANT_UPI_ID=
MERCHANT_NAME=TranzLife Biosciences

# ---------- admin page (/api/admin) ----------
# At least 12 characters. Empty turns the admin page off.
ADMIN_PASSWORD=
